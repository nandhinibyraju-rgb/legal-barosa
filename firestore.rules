rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 0. leads collection (consultation leads from booking page & modal popup)
    // - Unauthenticated and authenticated visitors can submit leads (public CREATE only)
    // - No public READ, UPDATE, or DELETE access (data can only be viewed/managed by admins or Firebase Console)
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 1. consultations collection
    // - Unauthenticated users cannot read any data at all, but CAN submit a consultation request (public lead capture)
    // - Any user (authenticated or not) can CREATE a "consultations" document
    // - Only admins or the submitting user (matched by userId) can READ it
    // - Only admins can update or delete consultations (e.g. changing status)
    match /consultations/{consultationId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 2. users collection (extends Firebase Auth with profile data)
    // - Users can read and initialize their own profile
    // - Users cannot promote themselves to 'admin' (only admin can change role or manual console edit)
    // - Admins have full read/write access to all user profiles
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdmin() || (isOwner(userId) && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'client'));
      allow update: if isAdmin() || (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || request.resource.data.role == resource.data.role));
      allow delete: if isAdmin() || isOwner(userId);

      // Strict AI Chat Privacy & Isolation (Only the authenticated owner UID can read or write)
      match /aiChats/{chatId} {
        allow read, write, create, update, delete: if isAuthenticated() && request.auth.uid == userId;

        match /{subcollection}/{docId} {
          allow read, write, create, update, delete: if isAuthenticated() && request.auth.uid == userId;
        }
      }

      // Legacy AI Case Intelligence subcollections (Strict User Isolation)
      match /aiCases/{caseId} {
        allow read, write, create, update, delete: if isAuthenticated() && request.auth.uid == userId;

        match /{subcollection}/{docId} {
          allow read, write, create, update, delete: if isAuthenticated() && request.auth.uid == userId;
        }
      }
    }

    // 3. cases collection (case records linked to a client)
    // - Users can only read and write their own cases (matched by userId)
    // - Admins can read and write all cases across all clients
    match /cases/{caseId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // 4. messages collection (message thread per case)
    // - Users can read and create messages for their own cases (matched by senderId / case ownership)
    // - Admins can read and write all messages across all cases
    match /messages/{messageId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        get(/databases/$(database)/documents/cases/$(resource.data.caseId)).data.userId == request.auth.uid
      ));
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.userId == request.auth.uid
      );
    }

    // 5. articles collection (Community & Knowledge platform with secure moderation)
    // - Anyone can read approved/published articles; authors can read their own; admins can read all
    // - Authenticated users can create articles with status 'draft' or 'pending' (cannot self-approve)
    // - Authors can update drafts or changes_requested articles, resubmitting as 'pending' or 'draft'
    // - Authors CANNOT set status to 'approved' or modify admin moderation fields
    // - Admins have full moderation authority (approve, request changes, reject, delete)
    match /articles/{articleId} {
      allow read: if resource.data.status in ['approved', 'published'] || 
                     (isAuthenticated() && resource.data.authorId == request.auth.uid) || 
                     isAdmin();
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (request.resource.data.authorId == request.auth.uid && request.resource.data.status in ['draft', 'pending'])
      );
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.authorId == request.auth.uid &&
          request.resource.data.status in ['draft', 'pending'] &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy', 
            'rejectionReason', 'changesRequestedAt', 'changesRequestedBy', 'adminFeedback'
          ])
        ) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes', 'bookmarks', 'commentsCount']);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // 6. articleComments collection (Comments on articles)
    // - Anyone can read comments
    // - Authenticated users can post comments
    // - Comment author or admin can delete
    match /articleComments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    // 7. reports collection (Community moderation safety)
    // - Public create (anyone can report inappropriate content)
    // - Admin-only read, update, delete
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 8. settings collection (Website Content: homepage, contact, booking)
    // - Public read for website rendering
    // - Admin-only write (create, update, delete)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. services collection (Dynamic Legal Services Directory)
    // - Anyone can read published services; admins can read all (including drafts)
    // - Admin-only write (create, update, delete)
    match /services/{serviceId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // 10. clientStories collection (Verified Real Client Case Studies & Testimonials)
    // - Anyone can read published stories; admins can read all
    // - Admin-only write (create, update, delete)
    match /clientStories/{storyId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
  }
}
// Final submission update
